FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY packages/api.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ .
COPY config/ config/
COPY lib/ lib/
COPY utils/ utils/

EXPOSE 8080

CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port 8080"]
